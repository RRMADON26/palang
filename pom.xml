<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.rrmadon</groupId>
  <artifactId>palang-parent</artifactId>
  <version>0.3.0</version>
  <packaging>pom</packaging>

  <name>Palang Parent</name>
  <description>Cross-cutting concerns toolkit for Spring Boot</description>
  <url>https://github.com/RRMADON26/palang</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>RRMADON26</id>
      <name>Rizky Romadon</name>
      <email>dev.rrmadon@gmail.com</email>
      <url>https://github.com/RRMADON26</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/RRMADON26/palang.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/RRMADON26/palang.git</developerConnection>
    <url>https://github.com/RRMADON26/palang</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-boot.version>3.3.5</spring-boot.version>
  </properties>

  <modules>
    <module>palang-bom</module>
    <module>palang-core</module>
    <module>palang-idempotency-spring-boot-starter</module>
    <module>palang-testkit</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.rrmadon</groupId>
        <artifactId>palang-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rrmadon</groupId>
        <artifactId>palang-idempotency-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rrmadon</groupId>
        <artifactId>palang-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Pinned deliberately. Without an explicit version Maven binds whatever
          compiler plugin its own version defaults to; older Mavens bind 3.1, which
          predates the 'release' parameter, silently ignores maven.compiler.release
          and falls back to source/target 5. The build then fails with "Source
          option 5 is no longer supported" on a project that compiles fine locally.
          Pinning the version and setting release here makes the toolchain explicit
          on every machine, including build services.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
          <configuration>
            <argLine>-XX:+EnableDynamicAgentLoading</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
          <configuration>
            <doclint>all,-missing</doclint>
            <quiet>true</quiet>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <!--
        Everything Maven Central demands beyond an ordinary build: sources,
        javadoc, and a GPG signature per file. Confined to a profile so a
        contributor running ./mvnw verify never needs a signing key.

        Publish with:  ./mvnw -Prelease deploy
      -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- Reads the passphrase from settings.xml rather than prompting,
                       which a non-interactive release build cannot answer. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                Deliberately manual. A release on Central is permanent: it cannot be
                deleted, replaced, or re-tagged. This uploads the bundle and stops,
                so the deployment is reviewed in the Portal before it becomes
                irreversible.
              -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
